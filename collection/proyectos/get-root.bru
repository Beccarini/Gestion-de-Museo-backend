meta {
  name: Get proyectos all
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/proyectos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:post-response {
  const data = res.getBody();
  
  if (data && data.proyectos && data.proyectos.length > 0) {
      bru.setEnvVar("proyectoId", data.proyectos[0].id);
      console.log("✅ proyectoId guardado:", data.proyectos[0].id);
      
  } else if (data && data.data && data.data.length > 0) {
      bru.setEnvVar("proyectoId", data.data[0].id);
      console.log("✅ proyectoId guardado (desde data):", data.data[0].id);
      
  } else if (Array.isArray(data) && data.length > 0) {
      bru.setEnvVar("proyectoId", data[0].id);
      console.log("✅ proyectoId guardado (desde Array puro):", data[0].id);
  } else {
      console.log("❌ No se encontró ningún proyecto.");
  }
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
