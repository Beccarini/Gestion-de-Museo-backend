meta {
  name: Get recursos all
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/recursos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:post-response {
  const data = res.getBody();
  
  if (data && data.recursos && data.recursos.length > 0) {
      bru.setEnvVar("recursoId", data.recursos[0].id);
      console.log("✅ recursoId guardado:", data.recursos[0].id);
      
  } else if (data && data.data && data.data.length > 0) {
      bru.setEnvVar("recursoId", data.data[0].id);
      console.log("✅ recursoId guardado (desde data):", data.data[0].id);
      
  } else if (Array.isArray(data) && data.length > 0) {
      bru.setEnvVar("recursoId", data[0].id);
      console.log("✅ recursoId guardado (desde Array puro):", data[0].id);
  } else {
      console.log("❌ No se encontró ningún recurso.");
  }
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
